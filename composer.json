{
    "name": "infinitetoken/lumber",
    "description": "PHP client for Lumber: end-to-end encrypted cloud logging, with a PSR-3 logger, a Monolog handler and a Laravel log channel",
    "type": "library",
    "license": "MIT",
    "keywords": ["lumber", "logging", "logger", "psr-3", "monolog", "laravel", "cloud-logging", "encryption", "aes-256-gcm", "end-to-end-encryption"],
    "homepage": "https://lumber.infinitetoken.com",
    "authors": [
        {
            "name": "Jay Deaton",
            "homepage": "https://www.infinitetoken.com"
        }
    ],
    "support": {
        "issues": "https://github.com/infinitetoken/Lumber-PHP/issues",
        "source": "https://github.com/infinitetoken/Lumber-PHP",
        "docs": "https://lumber.infinitetoken.com/docs/getting-started"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "monolog/monolog": "^3.0",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "monolog/monolog": "To send Monolog's records to Lumber with LumberHandler (Monolog 3)"
    },
    "provide": {
        "psr/log-implementation": "3.0.0"
    },
    "autoload": {
        "psr-4": {
            "InfiniteToken\\Lumber\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InfiniteToken\\Lumber\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InfiniteToken\\Lumber\\Laravel\\LumberServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer check --diff",
        "format": "php-cs-fixer fix",
        "contract": "@php scripts/sync-contract.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
